<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="*" />
    <PackageReference Include="Azure.DigitalTwins.Core" Version="*" />
    <PackageReference Include="Azure.Identity" Version="*" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="*" />
    <PackageReference Include="Microsoft.Azure.WebJobs.Extensions.EventGrid" Version="*" />
    <PackageReference Include="Microsoft.NET.Sdk.Functions" Version="*" />
    <PackageReference Include="System.Net.Http" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
